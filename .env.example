# Application
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_nestjs

# Authentication
# Local example only. Replace with a strong secret outside source control.
JWT_KEY=replace-with-a-local-secret-at-least-32-characters-long

# Mail transport
# Mail is opt-in. When MAIL_ENABLED=true, all four values below are required.
MAIL_ENABLED=false
SERVICE_MAIL=
SERVICE_MAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
