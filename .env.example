# Application
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_nestjs

# Authentication
# Local example only. Replace with a strong secret outside source control.
JWT_KEY=replace-with-a-local-secret-at-least-32-characters-long

# Mail transport
# B2 will make the enabled/required contract explicit. Empty credentials are intentional here.
SERVICE_MAIL=
SERVICE_MAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
