{
  "name": "ecommerce-pinotti",
  "version": "0.0.1",
  "description": "Academic NestJS ecommerce backend with a documented 2026 modernization track.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit --incremental false",
    "typecheck:all": "tsc -p tsconfig.json --noEmit --incremental false",
    "format": "npm run format:write",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:write": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "npm run test:unit",
    "test:unit": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:b2:runtime": "npm run build && node scripts/b2/runtime-contract.mjs",
    "test:b3:auth": "npm run build && node scripts/b3/auth-runtime.mjs",
    "test:b4:recovery": "npm run build && node scripts/b4/recovery-runtime.mjs",
    "test:b5:domain": "npm run build && node scripts/b5/domain-runtime.mjs",
    "quality:hygiene": "node scripts/quality/hygiene.mjs",
    "quality:lint-baseline": "node scripts/quality/lint-baseline.mjs",
    "quality:unit-baseline": "node scripts/quality/unit-baseline.mjs",
    "quality": "npm run quality:hygiene && npm run typecheck && npm run build && npm run quality:lint-baseline && npm run quality:unit-baseline && git diff --exit-code"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/mapped-types": "12.0.0",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.0.3",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "cookie-parser": "1.4.7",
    "express-handlebars": "7.1.3",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.4",
    "mongoose-paginate-v2": "1.9.5",
    "nodemailer": "10.0.10",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "12.0.3",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^4.17.17",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.5",
    "@types/passport": "1.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "babel-jest": "29.7.0",
    "babel-plugin-transform-import-meta": "2.3.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-prettier": "5.5.6",
    "jest": "29.7.0",
    "prettier": "3.9.8",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+[.]ts$": "ts-jest",
      "^.+[.]js$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                },
                "modules": "commonjs"
              }
            ]
          ],
          "plugins": [
            "babel-plugin-transform-import-meta"
          ]
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!@nestjs/)"
    ]
  },
  "overrides": {
    "glob": "10.5.0",
    "picomatch": "4.0.4"
  }
}
